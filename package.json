{
  "name": "hangar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "description": "Desktop manager for many Claude Code agents",
  "license": "MIT",
  "author": "Matt Lewis",
  "homepage": "https://github.com/mrltech-alt/hangar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrltech-alt/hangar.git"
  },
  "bugs": {
    "url": "https://github.com/mrltech-alt/hangar/issues"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:real": "HANGAR_HOME=$HOME/.hangar node scripts/dev.mjs",
    "build": "electron-vite build",
    "app": "node scripts/package.mjs",
    "build:dictate": "node scripts/build-dictate.mjs",
    "start": "node scripts/dev.mjs --built",
    "host": "node --disable-warning=ExperimentalWarning host/main.ts",
    "test": "vitest run && node scripts/smoke-host.mjs",
    "test:unit": "vitest run",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "publish:public": "node scripts/publish.mjs",
    "postinstall": "node scripts/fix-node-pty.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.11",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.42.0",
    "node-pty": "1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.2.0",
    "electron-builder": "26.16.1",
    "electron-vite": "5.0.0",
    "eslint": "^9.0.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
